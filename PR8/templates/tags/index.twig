{% extends "layouts/base.twig" %}

{% block title %}Керування тегами{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="mb-4">Керування тегами</h1>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-3">Додати новий тег</h4>
                    <form action="/tags" method="post" class="row g-3">
                        <div class="col-auto">
                            <input type="text" name="name" class="form-control" placeholder="Назва тегу" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-success">Додати</button>
                        </div>
                    </form>
                </div>
            </div>

            <h3 class="mt-5 mb-3">Існуючі теги ({{ tags|length }})</h3>

            {% if tags is empty %}
                <div class="alert alert-info">
                    Поки що немає тегів.
                </div>
            {% else %}
                <div class="list-group">
                    {% for tag in tags %}
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary rounded-pill me-3">#{{ loop.index }}</span>
                            <strong>{{ tag.name }}</strong>
                            <form action="/tags/{{ tag.id }}" method="post" onsubmit="return confirm('Видалити тег «{{ tag.name }}»?')">
                                <input type="hidden" name="_METHOD" value="DELETE">
                                <button type="submit" class="btn btn-sm btn-danger">Видалити</button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="text-center mt-4">
                <a href="/" class="btn btn-secondary">← На головну</a>
            </div>
        </div>
    </div>
{% endblock %}