{% extends "layouts/base.twig" %}

{% block title %}Новий пост{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="mb-4">Новий пост</h1>

            <form action="/posts" method="post">
                <div class="mb-3">
                    <label class="form-label">Заголовок</label>
                    <input type="text" name="title" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Зміст</label>
                    <textarea name="content" class="form-control" rows="10" required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Теги (Ctrl+клік для вибору кількох)</label>
                    <select name="tags[]" class="form-select" multiple size="5">
                        {% for tag in tags %}
                            <option value="{{ tag.id }}">{{ tag.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="btn btn-success btn-lg">Опублікувати</button>
                <a href="/" class="btn btn-secondary btn-lg ms-2">Скасувати</a>
            </form>
        </div>
    </div>
{% endblock %}