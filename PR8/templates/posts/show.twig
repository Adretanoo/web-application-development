{% extends "layouts/base.twig" %}

{% block title %}{{ post.title }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h1 class="card-title">{{ post.title }}</h1>
                    <p class="text-muted">
                        Автор: <strong>{{ post.user.username }}</strong> |
                        Опубліковано: {{ post.created_at|date("d.m.Y H:i") }}
                    </p>

                    {% if post.tags|length > 0 %}
                        <p>
                            <strong>Теги:</strong>
                            {% for tag in post.tags %}
                                <span class="badge bg-info text-dark me-1">{{ tag.name }}</span>
                            {% endfor %}
                        </p>
                    {% endif %}

                    <hr>

                    <div class="mb-4">
                        {{ post.content|nl2br }}
                    </div>

                    {% if session.is_admin %}
                        <div class="mb-4">
                            <a href="/posts/{{ post.id }}/edit" class="btn btn-warning">Редагувати пост</a>
                            <form action="/posts/{{ post.id }}" method="post" style="display:inline;" onsubmit="return confirm('Видалити пост?')">
                                <input type="hidden" name="_METHOD" value="DELETE">
                                <button type="submit" class="btn btn-danger">Видалити пост</button>
                            </form>
                        </div>
                    {% endif %}

                    <h3 class="mt-5">Коментарі ({{ post.comments|length }})</h3>
                    <hr>

                    {% for comment in post.comments %}
                        <div class="border-start border-primary border-4 ps-3 mb-4 p-3 bg-light rounded">
                            <p class="mb-1">
                                <strong>{{ comment.user.username }}</strong>
                                <small class="text-muted">{{ comment.created_at|date("d.m.Y H:i") }}</small>
                            </p>
                            <p class="mb-2">{{ comment.content|nl2br }}</p>

                            {% if session.user_id == comment.user_id or session.is_admin %}
                                <div class="d-flex gap-2">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-warning"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editCommentModal"
                                            data-comment-id="{{ comment.id }}"
                                            data-content="{{ comment.content|e('html_attr') }}">
                                        Редагувати
                                    </button>

                                    <form action="/comments/{{ comment.id }}" method="post" style="display:inline;">
                                        <input type="hidden" name="_METHOD" value="DELETE">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Видалити коментар?')">
                                            Видалити
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="text-muted">Поки немає коментарів. Будь першим!</p>
                    {% endfor %}

                    {% if session.user_id %}
                        <h4 class="mt-5">Додати коментар</h4>
                        <form action="/comments" method="post">
                            <textarea name="content" class="form-control mb-3" rows="4" placeholder="Ваш коментар..." required></textarea>
                            <input type="hidden" name="post_id" value="{{ post.id }}">
                            <button type="submit" class="btn btn-primary">Надіслати коментар</button>
                        </form>
                    {% else %}
                        <div class="alert alert-info mt-4">
                            <a href="/login">Увійдіть</a>, щоб залишити коментар.
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="text-center mb-5">
                <a href="/" class="btn btn-secondary btn-lg">← Назад до списку постів</a>
            </div>
        </div>
    </div>

    <!-- Модальне вікно для редагування коментаря -->
    <div class="modal fade" id="editCommentModal" tabindex="-1" aria-labelledby="editCommentModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editCommentModalLabel">Редагувати коментар</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editCommentForm" method="post">
                    <div class="modal-body">
                        <input type="hidden" name="_METHOD" value="PUT">
                        <input type="hidden" name="comment_id" id="editCommentId">
                        <textarea name="content" class="form-control" rows="5" id="editCommentContent" required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                        <button type="submit" class="btn btn-warning">Зберегти зміни</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        const editModal = document.getElementById('editCommentModal');
        editModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            const commentId = button.getAttribute('data-comment-id');
            const content = button.getAttribute('data-content');

            const modalContent = editModal.querySelector('#editCommentContent');
            const modalId = editModal.querySelector('#editCommentId');

            modalContent.value = content;
            modalId.value = commentId;

            // Динамічно встановлюємо action форми
            const form = editModal.querySelector('#editCommentForm');
            form.action = '/comments/' + commentId;
        });
    </script>
{% endblock %}