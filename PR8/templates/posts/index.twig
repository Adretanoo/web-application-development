{% extends "layouts/base.twig" %}

{% block title %}Усі пости{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="mb-4 text-center">Усі пости</h1>

            {% if session.is_admin %}
                <div class="text-center mb-4">
                    <a href="/posts/create" class="btn btn-success btn-lg">+ Новий пост</a>
                </div>
            {% endif %}

            {% if posts is empty %}
                <div class="alert alert-info text-center">
                    Поки що немає постів. {% if session.is_admin %}Створіть перший!{% endif %}
                </div>
            {% else %}
                {% for post in posts %}
                    <div class="card post-card mb-4 shadow-sm">
                        <div class="card-body">
                            <h3 class="card-title">
                                <a href="/posts/{{ post.id }}" class="text-decoration-none">{{ post.title }}</a>
                            </h3>
                            <p class="card-text text-muted">
                                Автор: <strong>{{ post.user.username }}</strong> |
                                {{ post.created_at|date("d.m.Y H:i") }}
                            </p>
                            <p class="card-text">
                                {{ post.content|slice(0, 200) }}{% if post.content|length > 200 %}...{% endif %}
                            </p>
                            {% if post.tags|length > 0 %}
                                <p class="card-text">
                                    <strong>Теги:</strong>
                                    {% for tag in post.tags %}
                                        <span class="badge bg-secondary">{{ tag.name }}</span>
                                    {% endfor %}
                                </p>
                            {% endif %}
                            <a href="/posts/{{ post.id }}" class="btn btn-primary">Читати далі →</a>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
{% endblock %}